{
  "name": "dsh-tps",
  "version": "0.3.0",
  "description": "Running-turn TPS badge for DSH Web: live tokens-per-second inside the Deep diving status row",
  "private": true,
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "rm -rf lib && tsc -b && tsdown",
    "dev": "tsdown --watch",
    "prepare": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "clsx": "^2.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-alpha.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "jsdom": "^26.0.0",
    "lightningcss": "^1.32.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "files": [
    "cordis.yml",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "locale",
    "docs",
    "icon.svg",
    "src"
  ]
}
